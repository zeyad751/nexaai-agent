# Copy this file to .env and fill in the values. Never commit .env.

# Required: used by the agent (gpt-5.6-sol) and by document search embeddings
# (text-embedding-3-small).
OPENAI_API_KEY=

# Used by the FastAPI backend (added in Phase 2):
# shared access code that users must enter in the web app
NEXAAI_ACCESS_CODE=
# comma-separated list of frontend addresses allowed to call the API
ALLOWED_ORIGINS=http://localhost:5173

# Optional: which OpenAI model the agent uses (default gpt-5.6-sol, the evaluated model).
# NEXAAI_MODEL=gpt-6.1-sol
# NEXAAI_USE_RESPONSES_API=true
# NEXAAI_TEMPERATURE=none
